        SILVER_bookings.*

        ,

    

        SILVER_listings.HOST_ID,
                     SILVER_listings.PROPERTY_TYPE,
                     SILVER_listings.ROOM_TYPE,
                     SILVER_listings.CITY,
                     SILVER_listings.COUNTRY,
                     SILVER_listings.ACCOMMODATES,
                     SILVER_listings.BEDROOMS,
                     SILVER_listings.BATHROOMS,
